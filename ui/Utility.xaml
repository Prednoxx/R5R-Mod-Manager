<Grid x:Name="UtilityView" Grid.Row="1" Grid.Column="1" Margin="24" Visibility="Collapsed">
  <StackPanel x:Name="SettingsView" Visibility="Collapsed">
    <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,24"/>
    <ContentControl Template="{StaticResource Glass}" Padding="22"><StackPanel>
      <TextBlock Text="Game folder" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
      <TextBlock x:Name="SettingsGamePath" Text="Not selected" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,16"/>
      <Button x:Name="BtnSettingsGame" Style="{StaticResource Btn}" Content="Choose game folder" HorizontalAlignment="Left"/>
      <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,28,0,14"/>
      <Button x:Name="BtnSettingsTheme" Style="{StaticResource Btn}" Content="Change theme" HorizontalAlignment="Left"/>
      <TextBlock Text="Catalog" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,28,0,10"/>
      <TextBlock Text="Listings refresh every 30 minutes. Cached listings and previews remain available offline." Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
      <Button x:Name="BtnSettingsSources" Style="{StaticResource Btn}" Content="View sources" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </StackPanel></ContentControl>
  </StackPanel>
  <Grid x:Name="DownloadsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Downloads" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,24"/>
    <ContentControl Grid.Row="1" Template="{StaticResource Glass}" Padding="22"><StackPanel>
      <TextBlock x:Name="DownloadName" Text="No active downloads" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
      <TextBlock x:Name="DownloadStatus" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <ProgressBar x:Name="DownloadProgress" Height="5" Margin="0,18,0,0" Visibility="Collapsed"/>
      <Button x:Name="BtnDownloadCancel" Style="{StaticResource Btn}" Content="Cancel download" HorizontalAlignment="Left" Margin="0,18,0,0" IsEnabled="False"/>
    </StackPanel></ContentControl>
    <TextBlock Grid.Row="2" x:Name="DownloadHistory" Text="" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="22" Margin="0,22,0,0"/>
  </Grid>
</Grid>
