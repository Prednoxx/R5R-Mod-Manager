<Grid x:Name="StoreView" Grid.Row="1" Grid.Column="1" Margin="22,18,20,14">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="StoreBrowse">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StoreSyncText" Text="Loading catalog" Foreground="{DynamicResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="BtnStoreSources" Style="{StaticResource Btn}" Content="Sources"/><Button x:Name="BtnStoreRefresh" Style="{StaticResource Btn}" Content="Refresh" Margin="0"/></StackPanel>
      <StackPanel><TextBlock Text="Mods Store" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="StoreCount" Text="Loading catalog" FontSize="13" Foreground="{DynamicResource TextDim}" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,12,0">
          <TextBox x:Name="StoreSearch" Height="36" Padding="31,8,10,6" Background="{DynamicResource InputBg}" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" BorderBrush="{DynamicResource InputBorder}" ToolTip="Search mods, authors and descriptions"/>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
          <TextBlock Text="Search mods" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StoreSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <CheckBox x:Name="StoreFavoritesOnly" Grid.Column="1" Content="Favorites" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox x:Name="StoreSort" Grid.Column="2" Style="{StaticResource StoreCombo}" Height="36" ToolTip="Sort order"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><ComboBox x:Name="StoreBuild" Style="{StaticResource StoreCombo}" Width="165" Height="30" Margin="0,0,10,0" ToolTip="Game build"/><ComboBox x:Name="StoreSourceFilter" Style="{StaticResource StoreCombo}" Width="165" Height="30" Margin="0,0,10,0" ToolTip="Catalog source"/><ComboBox x:Name="StoreCategory" Style="{StaticResource StoreCombo}" Width="210" Height="30" Margin="0,0,10,0" ToolTip="Category"/><Button x:Name="BtnStoreClear" Style="{StaticResource Btn}" Content="Clear filters" Height="30"/></StackPanel>
    </StackPanel>
    <Grid Grid.Row="2">
      <ListBox x:Name="StoreList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,18"/><Setter Property="Width" Value="{DynamicResource StoreCardWidth}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="9" ClipToBounds="True"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentStrong}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentStrong}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel>
          <Button Tag="details" Style="{StaticResource PreviewButton}" Height="168" HorizontalAlignment="Stretch" ToolTip="View mod details"><Grid Background="{DynamicResource Inset}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{DynamicResource AccentStrong}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="Preview unavailable" FontSize="10" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
            <Image Source="{Binding PreviewPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Background="#D9111111" Padding="7,4" CornerRadius="4" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FFF3E5C0"/></Border>
          </Grid></Button>
          <StackPanel Margin="12,10,12,12"><Button Tag="details" Style="{StaticResource PreviewButton}" HorizontalContentAlignment="Left" ToolTip="View mod details"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/></Button><TextBlock Text="{Binding AuthorLabel}" FontSize="11.5" Foreground="{DynamicResource TextDim}" Margin="0,6,0,12" TextTrimming="CharacterEllipsis"/>
            <DockPanel><Button Tag="install" Style="{StaticResource IconBtn}" Content="&#xE896;" DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="Install mod" IsEnabled="{Binding CanInstall}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Stats}" FontSize="10.5" Foreground="{DynamicResource TextDim}"/><TextBlock Text="{Binding Build}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" Margin="0,5,0,0"/></StackPanel></DockPanel>
          </StackPanel>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="StoreEmpty" Text="No matching mods" Foreground="{DynamicResource TextDim}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
  </Grid>
  <ScrollViewer x:Name="StoreDetails" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
    <Button x:Name="BtnStoreBack" Style="{StaticResource Btn}" Content="&#x2190; Back to mods" HorizontalAlignment="Left" Margin="0,0,0,20"/>
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="9" ClipToBounds="True"><StackPanel>
      <Grid Height="260" Background="{DynamicResource Inset}"><Image x:Name="StoreHero" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#22000000" Offset="0"/><GradientStop Color="#EA101010" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Bottom" Margin="24"><TextBlock x:Name="StoreDetailName" FontSize="29" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/><TextBlock x:Name="StoreDetailCategory" FontSize="13" Foreground="#D9FFFFFF" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
      <UniformGrid Columns="4" Margin="22,18,12,0"><Border Background="{DynamicResource Inset}" CornerRadius="5" Padding="12" Margin="0,0,10,0"><StackPanel><TextBlock Text="AUTHOR" FontSize="10" Foreground="{DynamicResource TextFaint}"/><TextBlock x:Name="StoreDetailAuthor" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border><Border Background="{DynamicResource Inset}" CornerRadius="5" Padding="12" Margin="0,0,10,0"><StackPanel><TextBlock Text="DOWNLOADS" FontSize="10" Foreground="{DynamicResource TextFaint}"/><TextBlock x:Name="StoreDetailDownloads" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border><Border Background="{DynamicResource Inset}" CornerRadius="5" Padding="12" Margin="0,0,10,0"><StackPanel><TextBlock Text="VERSION" FontSize="10" Foreground="{DynamicResource TextFaint}"/><TextBlock x:Name="StoreDetailVersion" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border><Border Background="{DynamicResource Inset}" CornerRadius="5" Padding="12" Margin="0,0,10,0"><StackPanel><TextBlock Text="SOURCE" FontSize="10" Foreground="{DynamicResource TextFaint}"/><TextBlock x:Name="StoreDetailSource" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></UniformGrid>
      <TextBlock x:Name="StoreDetailMeta" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="24,18,24,0"/><TextBlock x:Name="StoreCompatibility" Foreground="{DynamicResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="24,12,24,0"/>
      <DockPanel Margin="22,20,22,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="BtnStoreFavorite" Style="{StaticResource Btn}" Content="&#x2606; Favorite"/><Button x:Name="BtnStoreInstall" Style="{StaticResource BtnAccent}" Content="Install mod" Margin="0" MinWidth="145"/></StackPanel><Button x:Name="BtnStorePage" Style="{StaticResource Btn}" Content="View source" HorizontalAlignment="Left"/></DockPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,20,0,0"><StackPanel><TextBlock Text="Description" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,16"/><TextBlock x:Name="StoreDetailDescription" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap" LineHeight="21"/><TextBlock x:Name="StoreDetailDependencies" FontSize="12" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="18" Margin="0,16,0,0"/></StackPanel></Border>
    <StackPanel x:Name="StoreGalleryWrap" Margin="0,22,0,10" Visibility="Collapsed"><TextBlock Text="Gallery" Foreground="{DynamicResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl x:Name="StoreGallery"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="gallery" Style="{StaticResource PreviewButton}" Margin="0,0,12,12" ToolTip="View image"><Image Source="{Binding}" Width="220" Height="145" Stretch="UniformToFill"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StoreProgressText" Text="R5Reloaded S3" Foreground="{DynamicResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="StoreProgress" Height="4" Margin="0,7,20,0" Visibility="Collapsed"/></StackPanel><Button x:Name="BtnStoreCancel" Grid.Column="1" Style="{StaticResource Btn}" Content="Cancel download" Visibility="Collapsed" Margin="12,0,0,0"/></Grid>
  <Grid x:Name="ImageOverlay" Grid.RowSpan="2" Background="#F00E0E0E" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Name="BtnImageClose" Style="{StaticResource Btn}" Content="Close preview" HorizontalAlignment="Right" Margin="12"/><Image x:Name="FullPreview" Grid.Row="1" Stretch="Uniform" Margin="20"/></Grid>
</Grid>